<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.moviecollection.MainController">
   <children>
      <ListView fx:id="movieListView" layoutX="14.0" layoutY="14.0" prefHeight="329.0" prefWidth="572.0" />
      <Button fx:id="logoutButton" layoutX="14.0" layoutY="357.0" mnemonicParsing="false" onAction="#logout" text="Logout" />
      <Button fx:id="manageMoviesButton" layoutX="250.0" layoutY="357.0" mnemonicParsing="false" onAction="#manageMovies" text="Gestionar Películas" />
      <Button fx:id="closeButton" layoutX="532.0" layoutY="357.0" mnemonicParsing="false" onAction="#close" text="Close" />
   </children>
</AnchorPane>
