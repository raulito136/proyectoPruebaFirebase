<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.moviecollection.MovieController">
   <children>
      <TableView fx:id="movieTableView" layoutX="14.0" layoutY="14.0" prefHeight="329.0" prefWidth="572.0">
        <columns>
          <TableColumn fx:id="titleColumn" prefWidth="150.0" text="Título" />
          <TableColumn fx:id="genreColumn" prefWidth="100.0" text="Género" />
            <TableColumn fx:id="yearColumn" prefWidth="75.0" text="Año" />
            <TableColumn fx:id="directorColumn" prefWidth="150.0" text="Director" />
        </columns>
      </TableView>
      <Button fx:id="addButton" layoutX="14.0" layoutY="357.0" mnemonicParsing="false" onAction="#addMovie" text="Añadir" />
      <Button fx:id="editButton" layoutX="80.0" layoutY="357.0" mnemonicParsing="false" onAction="#editMovie" text="Editar" />
      <Button fx:id="deleteButton" layoutX="140.0" layoutY="357.0" mnemonicParsing="false" onAction="#deleteMovie" text="Eliminar" />
      <Button fx:id="manageCopiesButton" layoutX="220.0" layoutY="357.0" mnemonicParsing="false" onAction="#manageCopies" text="Gestionar Copias" />
      <Button fx:id="backButton" layoutX="532.0" layoutY="357.0" mnemonicParsing="false" onAction="#back" text="Volver" />
   </children>
</AnchorPane>
