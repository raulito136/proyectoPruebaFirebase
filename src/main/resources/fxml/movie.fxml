<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.moviecollection.controller.MovieController">
   <children>
      <TableView fx:id="movieTableView" layoutX="14.0" layoutY="14.0" prefHeight="329.0" prefWidth="572.0">
        <columns>
          <TableColumn fx:id="titleColumn" prefWidth="150.0" text="Título" />
          <TableColumn fx:id="genreColumn" prefWidth="100.0" text="Género" />
            <TableColumn fx:id="yearColumn" prefWidth="75.0" text="Año" />
            <TableColumn fx:id="directorColumn" prefWidth="150.0" text="Director" />
        </columns>
      </TableView>
      <Button fx:id="addCopyButton" layoutX="14.0" layoutY="357.0" mnemonicParsing="false" onAction="#addCopy" text="Añadir Copia" />
      <Button fx:id="editCopyButton" layoutX="120.0" layoutY="357.0" mnemonicParsing="false" onAction="#editCopy" text="Editar Copia" />
      <Button fx:id="deleteCopyButton" layoutX="220.0" layoutY="357.0" mnemonicParsing="false" onAction="#deleteCopy" text="Eliminar Copia" />
      <Button fx:id="backButton" layoutX="532.0" layoutY="357.0" mnemonicParsing="false" onAction="#back" text="Volver" />
   </children>
</AnchorPane>
