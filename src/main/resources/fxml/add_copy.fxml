<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.moviecollection.controller.AddCopyController"
      spacing="15" alignment="CENTER" styleClass="root" prefWidth="600" prefHeight="400">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Añadir Nueva Copia" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TableView fx:id="movieTable" prefHeight="200">
        <columns>
            <TableColumn fx:id="titleColumn" text="Título" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="directorColumn" text="Director" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="yearColumn" text="Año" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="genreColumn" text="Género" style="-fx-alignment: CENTER;"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox spacing="10" alignment="CENTER">
        <ComboBox fx:id="formatComboBox" promptText="Formato" prefWidth="150"/>
        <ComboBox fx:id="stateComboBox" promptText="Estado" prefWidth="150"/>
    </HBox>

    <Button text="Añadir Copia" onAction="#addCopy" prefWidth="120"/>

</VBox>