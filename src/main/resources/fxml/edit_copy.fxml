<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="250.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.moviecollection.EditCopyController">
   <children>
      <Label layoutX="14.0" layoutY="14.0" text="Formato:" />
      <TextField fx:id="formatField" layoutX="150.0" layoutY="10.0" />
      <Label layoutX="14.0" layoutY="54.0" text="Ubicación:" />
      <TextField fx:id="locationField" layoutX="150.0" layoutY="50.0" />
      <Label layoutX="14.0" layoutY="94.0" text="Propietario:" />
      <ComboBox fx:id="ownerComboBox" layoutX="150.0" layoutY="90.0" prefWidth="150.0" />
      <Button fx:id="saveButton" layoutX="150.0" layoutY="200.0" mnemonicParsing="false" onAction="#save" text="Guardar" />
      <Button fx:id="cancelButton" layoutX="220.0" layoutY="200.0" mnemonicParsing="false" onAction="#cancel" text="Cancelar" />
   </children>
</AnchorPane>
